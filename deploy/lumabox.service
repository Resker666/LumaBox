[Unit]
Description=LumaBox personal download service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/develop/lumabox
Environment=PLAYWRIGHT_BROWSERS_PATH=/home/dev/develop/lumabox/.venv/browsers
Environment=XDG_CACHE_HOME=/home/dev/develop/lumabox/WebData/cache
Environment=XDG_CONFIG_HOME=/home/dev/develop/lumabox/WebData/config
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1920x1080x24 -nolisten tcp" /home/dev/develop/lumabox/.venv/bin/python -m lumabox.web --remote --port 8765 --data /home/dev/develop/lumabox/WebData --output /home/dev/develop/lumabox/Output
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/dev/develop/lumabox/WebData /home/dev/develop/lumabox/Output
MemoryMax=1100M
TasksMax=512

[Install]
WantedBy=multi-user.target
